# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=UrbanShop
NODE_ENV=development

# ─── Database (PostgreSQL via Docker) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanshop?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urbanshop

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth.js (NextAuth v5) ───
AUTH_SECRET=generate-with-openssl-rand-base64-32  # run: openssl rand -base64 32
AUTH_URL=http://localhost:3000
# OAuth Providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── AWS S3 ───
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=urbanshop-uploads
AWS_S3_PUBLIC_URL=https://urbanshop-uploads.s3.amazonaws.com

# ─── Sentry ───
SENTRY_ORG=
SENTRY_PROJECT=urbanshop
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
